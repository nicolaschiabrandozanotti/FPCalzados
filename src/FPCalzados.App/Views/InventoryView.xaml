<UserControl x:Class="FPCalzados.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="8">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="1.1*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <GroupBox Header="Buscar y seleccionar producto" Margin="4">
        <WrapPanel>
            <StackPanel Width="290">
                <TextBlock Text="Buscar por marca, modelo, color, talle o codigo" Foreground="#374151"/>
                <TextBox x:Name="InventorySearchBox" ToolTip="F4 te trae aca. Enter busca."/>
            </StackPanel>
            <Button x:Name="RefreshInventoryButton" Content="Buscar" VerticalAlignment="Bottom"/>
            <Button x:Name="NewProductButton" Content="Nuevo producto" ToolTip="Limpia la carga para empezar otro producto." VerticalAlignment="Bottom"/>
            <Button x:Name="AdjustStockButton" Content="Mover stock" ToolTip="Ingreso, egreso o ajuste con motivo." VerticalAlignment="Bottom"/>
            <Button x:Name="ShowLowStockButton" Content="Ver bajo stock" VerticalAlignment="Bottom"/>
            <Button x:Name="DeactivateButton" Content="Dar de baja" VerticalAlignment="Bottom"/>
        </WrapPanel>
    </GroupBox>
    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="InventoryGrid">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                            <Setter Property="Background" Value="#FFF7ED"/>
                            <Setter Property="ToolTip" Value="Stock bajo o igual al nivel de alerta"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="*"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="100"/>
                <DataGridTextColumn Header="Talle" Binding="{Binding Size}" Width="70"/>
                <DataGridTextColumn Header="Codigo" Binding="{Binding Sku}" Width="100"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="70"/>
                <DataGridTextColumn Header="Alerta" Binding="{Binding LowStockThreshold}" Width="60"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding StockStatus}" Width="70"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding SupplierCost, StringFormat={}{0:C0}}" Width="100"/>
                <DataGridTextColumn Header="Precio efectivo" Binding="{Binding CashPrice, StringFormat={}{0:C0}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Header="Historial de movimientos de stock" Grid.Row="1" Margin="0,8,0,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top">
                    <Button x:Name="RefreshStockMovementsButton" Content="Ver últimos"/>
                    <Button x:Name="RefreshSelectedStockMovementsButton" Content="Ver producto seleccionado"/>
                    <Button x:Name="ExportStockMovementsButton" Content="Exportar historial"/>
                    <Button x:Name="ExportSelectedStockMovementsButton" Content="Exportar producto"/>
                    <TextBlock x:Name="StockMovementFilterText" VerticalAlignment="Center" Foreground="#475569" Margin="8,0,0,0"/>
                </WrapPanel>
                <DataGrid x:Name="StockMovementsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding OccurredAt, StringFormat={}{0:g}}" Width="130"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Brand}" Width="110"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="110"/>
                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>
                        <DataGridTextColumn Header="Talle" Binding="{Binding Size}" Width="60"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Converter={StaticResource StockMovementTypeDisplayConverter}}" Width="90"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding QuantityChange}" Width="60"/>
                        <DataGridTextColumn Header="Stock final" Binding="{Binding StockAfter}" Width="80"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
    <ScrollViewer Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <GroupBox Header="Carga de producto" Margin="4">
            <StackPanel>
                <TextBox x:Name="ProductIdBox" Visibility="Collapsed"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Proveedor"/><ComboBox x:Name="ProductSupplierBox" DisplayMemberPath="DisplayName"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="Marca"/><TextBox x:Name="BrandBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Modelo"/><TextBox x:Name="ModelBox"/></StackPanel>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Color"/><TextBox x:Name="VariantColorBox"/></StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="Talle"/><TextBox x:Name="VariantSizeBox"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Stock"/><TextBox x:Name="VariantStockBox" Text="0"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="AddVariantRowButton" Content="+" Width="34" Height="30" ToolTip="Agregar color, talle y stock"/>
                            <Button x:Name="RemoveSelectedVariantRowButton" Content="-" Width="34" Height="30" ToolTip="Eliminar la opcion seleccionada"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Opciones agregadas" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <DataGrid x:Name="VariantEditGrid" Grid.Row="3" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Height="125" SelectionUnit="CellOrRowHeader">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Talle" Binding="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <StackPanel Grid.Row="3" Grid.Column="0"><TextBlock Text="Stock total"/><TextBlock x:Name="TotalStockText" Text="0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1"><TextBlock Text="Precio proveedor"/><TextBox x:Name="SupplierCostBox"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0"><TextBlock Text="Precio venta base"/><TextBox x:Name="CashPriceBox" Text="0"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1"><TextBlock Text="Aviso stock bajo"/><TextBox x:Name="LowStockBox" Text="1"/></StackPanel>
                    <Button x:Name="SaveProductButton" Grid.Row="5" Grid.ColumnSpan="2" Content="Guardar producto (Ctrl+G)" HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
    </ScrollViewer>
</Grid>

</UserControl>
