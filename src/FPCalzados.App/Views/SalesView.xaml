<UserControl x:Class="FPCalzados.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl x:Name="SalesTabs" Margin="8" SelectionChanged="SalesTabs_SelectionChanged">
        <TabItem Header="Nueva venta (F2)">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.ColumnSpan="2" Background="#EEF6FF" BorderBrush="#B9D9FF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                    <TextBlock Foreground="#1F4E79" TextWrapping="Wrap">
                        <Run Text="Venta normal: busca y selecciona una variante, luego usa Ctrl+Enter."/>
                        <LineBreak/>
                        <Run Text="Venta rápida: escribe un código o búsqueda que identifique una única variante con stock y pulsa Agregar rápido. Después carga pagos y guarda con Ctrl+G."/>
                    </TextBlock>
                </Border>
                <GroupBox Header="1. Buscar producto para vender" Grid.Row="1" Margin="4">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <StackPanel Width="330"><TextBlock Text="Producto, codigo, color o talle"/><TextBox x:Name="SaleSearchBox" ToolTip="Ctrl+F o F2 te trae aca. Enter busca." KeyDown="SearchBox_KeyDown"/></StackPanel>
                            <Button Content="Buscar" Click="RefreshSaleInventory_Click" VerticalAlignment="Bottom"/>
                            <Button Content="Agregar rápido" Click="QuickAddSale_Click" VerticalAlignment="Bottom" ToolTip="Si la busqueda devuelve una sola variante con stock, la agrega al carrito."/>
                            <StackPanel Width="68"><TextBlock Text="Talle"/><ComboBox x:Name="SaleSizeFilterBox" SelectionChanged="SaleVariantFilter_SelectionChanged"/></StackPanel>
                            <StackPanel Width="120"><TextBlock Text="Color"/><ComboBox x:Name="SaleColorFilterBox" SelectionChanged="SaleVariantFilter_SelectionChanged"/></StackPanel>
                            <StackPanel Width="82"><TextBlock Text="Cantidad"/><TextBox x:Name="SaleQuantityBox" Text="1" MaxLength="4" TextChanged="SalePriceInput_Changed"/></StackPanel>
                            <StackPanel Width="115"><TextBlock Text="Descuento $"/><TextBox x:Name="SaleDiscountBox" Text="0" TextChanged="SalePriceInput_Changed"/></StackPanel>
                            <StackPanel Width="220"><TextBlock Text="Lista / forma de precio"/><ComboBox x:Name="SaleRuleBox" DisplayMemberPath="Name" SelectionChanged="SaleRuleBox_SelectionChanged"/></StackPanel>
                            <Button Content="Agregar al carrito (Ctrl+Enter)" Click="AddCart_Click" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4">
                            <TextBlock x:Name="SaleFinalPricePreviewText" Text="Selecciona una opcion para ver el precio final." Foreground="#334155" TextWrapping="Wrap"/>
                        </Border>
                        <DataGrid x:Name="SaleProductGrid" SelectionChanged="SaleProductGrid_SelectionChanged" PreviewMouseLeftButtonDown="SaleProductGrid_PreviewMouseLeftButtonDown" MouseDoubleClick="SaleProductGrid_MouseDoubleClick" RowDetailsVisibilityMode="Collapsed">
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" Margin="8,0,8,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Opciones de venta: selecciona una fila y usa Ctrl+Enter o doble click." Foreground="#475569" Margin="0,0,0,6"/>
                                            <DataGrid ItemsSource="{Binding Options}" SelectionChanged="SaleOptionGrid_SelectionChanged" MouseDoubleClick="SaleOptionGrid_MouseDoubleClick" MinHeight="90" MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Talle" Binding="{Binding Size}" Width="80"/>
                                                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="110"/>
                                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                                                    <DataGridTextColumn Header="Costo" Binding="{Binding SupplierCost, StringFormat={}{0:C0}}" Width="110"/>
                                                    <DataGridTextColumn Header="Precio final" Binding="{Binding CashPrice, StringFormat={}{0:C0}}" Width="120"/>
                                                    <DataGridTextColumn Header="Codigo" Binding="{Binding Sku}" Width="120"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="120"/>
                                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="140"/>
                                <DataGridTextColumn Header="Colores disponibles" Binding="{Binding ColorSummary}" Width="*"/>
                                <DataGridTextColumn Header="Talles disponibles" Binding="{Binding SizeSummary}" Width="1.3*"/>
                                <DataGridTextColumn Header="Stock total" Binding="{Binding TotalStock}" Width="90"/>
                                <DataGridTextColumn Header="Costo proveedor" Binding="{Binding SupplierCostSummary}" Width="120"/>
                                <DataGridTextColumn Header="Precio final" Binding="{Binding CashPriceSummary}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
                <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4"><TextBlock x:Name="SelectedSaleVariantText" Text="Selecciona un producto, talle y color para agregarlo al carrito." TextWrapping="Wrap" Foreground="#7C2D12"/></Border>
                        <GroupBox Header="2. Carrito" Margin="4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="Quitar seleccionado (Supr)" Click="RemoveCart_Click"/><TextBlock Text="Total:" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBlock x:Name="SaleTotalText" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="SaleCartBreakdownText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#475569"/></StackPanel>
                                <DataGrid x:Name="CartGrid" MinHeight="150" MaxHeight="210"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:C0}}" Width="100"/></DataGrid.Columns></DataGrid>
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="3. Cobro" Margin="4">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top">
                                    <StackPanel Width="140"><TextBlock Text="Medio de pago"/><ComboBox x:Name="PaymentMethodBox" DisplayMemberPath="Label" SelectedValuePath="Method"/></StackPanel>
                                    <StackPanel Width="115"><TextBlock Text="Monto cobrado"/><TextBox x:Name="PaymentAmountBox" Text="0"/></StackPanel>
                                    <StackPanel Width="70"><TextBlock Text="Cuotas"/><TextBox x:Name="PaymentInstallmentsBox" Text="1"/></StackPanel>
                                    <Button Content="Agregar pago (Ctrl+P)" Click="AddPayment_Click" VerticalAlignment="Bottom"/>
                                    <Button Content="Quitar pago" Click="RemovePayment_Click" VerticalAlignment="Bottom"/>
                                </WrapPanel>
                                <DataGrid x:Name="PaymentsGrid" MinHeight="110" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="Medio" Binding="{Binding Method, Converter={StaticResource PaymentMethodDisplayConverter}}" Width="90"/><DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat={}{0:C0}}" Width="110"/><DataGridTextColumn Header="Cuotas" Binding="{Binding Installments}" Width="70"/></DataGrid.Columns></DataGrid>
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="4. Cliente y cierre" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Opcional: completa cliente si queres identificar la venta o si queda saldo pendiente." Foreground="#5F6B7A" TextWrapping="Wrap"/>
                                <WrapPanel><StackPanel Width="135"><TextBlock Text="Nombre"/><TextBox x:Name="CustomerFirstNameBox"/></StackPanel><StackPanel Width="135"><TextBlock Text="Apellido"/><TextBox x:Name="CustomerLastNameBox"/></StackPanel><StackPanel Width="145"><TextBlock Text="Telefono"/><TextBox x:Name="CustomerPhoneBox"/></StackPanel></WrapPanel>
                                <WrapPanel><StackPanel Width="175"><TextBlock Text="Vence saldo"/><DatePicker x:Name="SaleDueDatePicker"/></StackPanel><Button Content="Guardar venta (Ctrl+G)" Click="SaveSale_Click" VerticalAlignment="Bottom"/><Button Content="Limpiar venta (Ctrl+L)" Click="ClearSale_Click" VerticalAlignment="Bottom"/></WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="Historial / devoluciones (F3)">
            <Grid Margin="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <GroupBox Header="Buscar venta" Margin="4"><WrapPanel><StackPanel Width="330"><TextBlock Text="Cliente, numero de venta o estado"/><TextBox x:Name="SalesSearchBox" ToolTip="F3 te trae aca. Enter busca." KeyDown="SearchBox_KeyDown"/></StackPanel><Button Content="Buscar / actualizar" Click="RefreshSales_Click" VerticalAlignment="Bottom"/><Button Content="Ver detalle" Click="ViewSaleDetail_Click" VerticalAlignment="Bottom"/><Button Content="Imprimir ticket" Click="PrintSaleReceipt_Click" VerticalAlignment="Bottom"/><Button Content="Exportar ticket TXT" Click="ExportSaleReceipt_Click" VerticalAlignment="Bottom"/><Button Content="Exportar comprobante XLSX" Click="ExportSaleDetail_Click" VerticalAlignment="Bottom"/><Button Content="Cambiar vencimiento" Click="ChangeDueDate_Click" VerticalAlignment="Bottom"/><Button Content="Registrar pago" Click="RegisterPayment_Click" VerticalAlignment="Bottom"/><Button Content="Devolver item seleccionado" Click="ReturnSelectedSale_Click" VerticalAlignment="Bottom"/></WrapPanel></GroupBox>
                <DataGrid x:Name="SalesGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Venta" Binding="{Binding SaleId}" Width="70"/><DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="Vence" Binding="{Binding DueDate}" Width="95"/><DataGridTextColumn Header="Neto" Binding="{Binding NetTotal, StringFormat={}{0:C0}}" Width="100"/><DataGridTextColumn Header="Cobrado" Binding="{Binding PaidTotal, StringFormat={}{0:C0}}" Width="100"/><DataGridTextColumn Header="Saldo" Binding="{Binding BalanceDue, StringFormat={}{0:C0}}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Status, Converter={StaticResource SaleStatusDisplayConverter}}" Width="110"/></DataGrid.Columns></DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
                    <Button Content="← Anterior" Click="PreviousSalesPage_Click"/>
                    <TextBlock x:Name="SalesPageText" Margin="12,6"/>
                    <Button Content="Siguiente →" Click="NextSalesPage_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Clientes / deudas">
            <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="Saldos pendientes" Margin="4"><WrapPanel><Button Content="Actualizar" Click="RefreshCustomerDebts_Click"/><Button Content="Ver historial" Click="ViewCustomerHistory_Click"/><Button Content="Exportar deudas" Click="ExportCustomerDebts_Click"/></WrapPanel></GroupBox><DataGrid x:Name="CustomerDebtsGrid" Grid.Row="1" MouseDoubleClick="CustomerDebtsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="Telefono" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Ventas pendientes" Binding="{Binding PendingSalesCount}" Width="120"/><DataGridTextColumn Header="Total pendiente" Binding="{Binding TotalPending, StringFormat={}{0:C0}}" Width="130"/><DataGridTextColumn Header="Proximo vencimiento" Binding="{Binding NextDueDate}" Width="140"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></Grid>
        </TabItem>
        <TabItem Header="Cobranzas">
            <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="Pagos cobrados" Margin="4"><WrapPanel><StackPanel Width="145"><TextBlock Text="Desde"/><DatePicker x:Name="CollectionsFromPicker"/></StackPanel><StackPanel Width="145"><TextBlock Text="Hasta"/><DatePicker x:Name="CollectionsToPicker"/></StackPanel><Button Content="Actualizar" Click="RefreshPaymentCollections_Click" VerticalAlignment="Bottom"/><Button Content="Exportar cobranzas" Click="ExportPaymentCollections_Click" VerticalAlignment="Bottom"/></WrapPanel></GroupBox><DataGrid x:Name="PaymentCollectionsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding PaidAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/><DataGridTextColumn Header="Venta" Binding="{Binding SaleId}" Width="70"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="Medio" Binding="{Binding Method, Converter={StaticResource PaymentMethodDisplayConverter}}" Width="100"/><DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat={}{0:C0}}" Width="110"/><DataGridTextColumn Header="Cuotas" Binding="{Binding Installments}" Width="70"/><DataGridTextColumn Header="Saldo venta" Binding="{Binding SaleBalanceDue, StringFormat={}{0:C0}}" Width="110"/></DataGrid.Columns></DataGrid></Grid>
        </TabItem>
    </TabControl>
</UserControl>
