<UserControl x:Class="FPCalzados.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Desde" VerticalAlignment="Center"/>
            <DatePicker x:Name="DashboardFromPicker"/>
            <TextBlock Text="Hasta" VerticalAlignment="Center"/>
            <DatePicker x:Name="DashboardToPicker"/>
            <Button x:Name="RefreshDashboardButton" Content="Actualizar (Ctrl+R)"/>
            <Button x:Name="OpenCashRegisterButton" Content="Abrir caja"/>
            <Button x:Name="CloseCashRegisterButton" Content="Cerrar caja"/>
            <Button x:Name="ExportCashRegisterButton" Content="Exportar cierre"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,8">
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Bruto" Foreground="#5F6B7A"/><TextBlock x:Name="GrossSalesText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Neto" Foreground="#5F6B7A"/><TextBlock x:Name="NetSalesText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Cobrado" Foreground="#5F6B7A"/><TextBlock x:Name="PaidSalesText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Pendiente" Foreground="#5F6B7A"/><TextBlock x:Name="PendingSalesText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Devuelto" Foreground="#5F6B7A"/><TextBlock x:Name="ReturnedSalesText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Bajo stock" Foreground="#5F6B7A"/><TextBlock x:Name="LowStockText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                <StackPanel><TextBlock Text="Vencidos" Foreground="#5F6B7A"/><TextBlock x:Name="OverdueText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Mas vendido" Margin="4">
                <DataGrid x:Name="TopProductsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="*"/>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="Neto" Binding="{Binding NetTotal, StringFormat={}{0:C0}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Header="Alertas" Grid.Column="1" Margin="4">
                <DataGrid x:Name="AlertsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Converter={StaticResource AlertTypeDisplayConverter}}" Width="130"/>
                        <DataGridTextColumn Header="Mensaje" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Header="Cierre de caja" Grid.Column="2" Margin="4">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Estado" Grid.Row="0"/><TextBlock x:Name="CashRegisterStatusText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Ventas" Grid.Row="1"/><TextBlock x:Name="CashRegisterSalesCountText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Efectivo" Grid.Row="2"/><TextBlock x:Name="CashRegisterCashText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Débito" Grid.Row="3"/><TextBlock x:Name="CashRegisterDebitText" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Crédito" Grid.Row="4"/><TextBlock x:Name="CashRegisterCreditText" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Cobrado" Grid.Row="5"/><TextBlock x:Name="CashRegisterPaidText" Grid.Row="5" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Pendiente" Grid.Row="6"/><TextBlock x:Name="CashRegisterPendingText" Grid.Row="6" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Devuelto" Grid.Row="7"/><TextBlock x:Name="CashRegisterReturnedText" Grid.Row="7" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="A devolver" Grid.Row="8"/><TextBlock x:Name="CashRegisterCashToReturnText" Grid.Row="8" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Caja inicial" Grid.Row="9"/><TextBlock x:Name="CashRegisterOpeningCashText" Grid.Row="9" Grid.Column="1" FontWeight="SemiBold"/>
                    <Separator Grid.Row="10" Grid.ColumnSpan="2" Margin="0,6"/>
                    <TextBlock Text="Caja esperada" Grid.Row="11" FontWeight="SemiBold"/><TextBlock x:Name="CashRegisterExpectedCashText" Grid.Row="11" Grid.Column="1" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Caja real" Grid.Row="12"/><TextBlock x:Name="CashRegisterClosingCashText" Grid.Row="12" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Text="Diferencia" Grid.Row="13"/><TextBlock x:Name="CashRegisterDifferenceText" Grid.Row="13" Grid.Column="1" FontWeight="SemiBold"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
